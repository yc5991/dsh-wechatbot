{
  "name": "dsh-wechatbot",
  "version": "0.5.0",
  "private": true,
  "description": "Zero-injection WeChat bot bridge for DSH (macOS & Windows RPA + official ClawBot QR channel), supporting group and private chats.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./reply-preset": "./lib/agent-preset.js",
    "./reply-preset/locale/*.json": "./locale/reply-preset/*.json",
    "./sticker-labels-preset": "./lib/agent-preset.js",
    "./sticker-labels-preset/locale/*.json": "./locale/sticker-labels-preset/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "agent/template",
    "agent/examples",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wechat",
    "wechat-bot",
    "clawbot",
    "ilink",
    "macos",
    "windows",
    "uia",
    "ocr"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yc5991/dsh-wechatbot.git"
  }
}
